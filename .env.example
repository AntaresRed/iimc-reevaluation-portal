# Copy this file to .env to change any of these settings.

# Port the portal listens on (3000 is used by another app on this machine)
PORT=3000

# Where requests, windows, faculty, deactivations and question photos are stored
# DATA_DIR=./data

# ===== Google Drive (optional) =====
# Photos are kept on this machine until these are filled in.
# Create a Desktop-app OAuth client at https://console.cloud.google.com/ (Drive API enabled),
# paste the two values below, then run:  node connect-drive.js
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Filled in automatically by connect-drive.js:
# GDRIVE_REFRESH_TOKEN=
# GDRIVE_ROOT_FOLDER_ID=

# ===== Photo retention =====
# Photos of the answer script are deleted this many days after the professor closes
# the request. Everything else about the request is kept forever.
# PHOTO_RETENTION_DAYS=30
# Lets a hosted cron job POST to /api/maintenance/sweep-photos. Leave empty and only
# this machine can run the sweep.
# MAINTENANCE_KEY=

# ===== Hosted deployment (Vercel) =====
# The serverless functions in api/ need the four GDRIVE_* values above set as Vercel
# environment variables, plus these two so they can check who is signed in:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Addresses outside this domain are refused by the upload endpoint.
# ALLOWED_EMAIL_DOMAIN=email.iimcal.ac.in
