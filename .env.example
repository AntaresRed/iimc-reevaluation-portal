# Copy this file to .env and fill in your Razorpay keys, then restart the server.
# Test keys: Razorpay Dashboard → Account & Settings → API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Razorpay Dashboard → Webhooks → add <public URL>/api/razorpay/webhook with events
# refund.processed and refund.failed, and paste the webhook secret here. Needs a public URL (not localhost).
RAZORPAY_WEBHOOK_SECRET=

# Flat fee per re-evaluation request, in rupees
PAYMENT_AMOUNT_INR=10

# Port 3000 is used by another app on this machine — change if needed
PORT=3000

# UPI QR payee. Leave empty to hide the UPI option.
# WARNING: real money — UPI has no test mode. Use the college's account for real use.
UPI_VPA=
UPI_PAYEE_NAME=IIM Calcutta
