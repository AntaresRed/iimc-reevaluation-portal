# Copy this file to .env and fill in your Razorpay keys, then restart the server.
# Test keys: Razorpay Dashboard → Account & Settings → API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Flat fee per re-evaluation request, in rupees
PAYMENT_AMOUNT_INR=10

# Port 3000 is used by another app on this machine — change if needed
PORT=3000
